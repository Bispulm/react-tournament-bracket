{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "dom",
      "es2020"
    ],
    "jsx": "react",
    "noEmit": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "react-tournament-bracket": [
        "../src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "../src/types"
  ]
}
