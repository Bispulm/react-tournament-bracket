{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "es2015"
    ],
    "jsx": "react",
    "noImplicitAny": true,
    "outDir": "lib",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "declaration": true
  },
  "ts-node": {
    "files": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/testing"
  ]
}